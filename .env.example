# Copernicus Data Space Ecosystem — Sentinel Hub
# Registrati gratis su https://dataspace.copernicus.eu
# Dashboard → OAuth Clients → Crea nuovo client
VITE_SENTINEL_CLIENT_ID=inserisci_qui_il_client_id
SENTINEL_CLIENT_SECRET=inserisci_qui_il_secret

# NOTA: VITE_ prefix = esposto al frontend (Vite lo inietta nel bundle).
# Il CLIENT_SECRET NON ha il prefisso VITE_ → non è accessibile dal browser.
# Il secret viene usato SOLO dalla Edge Function server-side (api/sentinel-token.ts).

# Sentinel Hub — Instance ID delle Configuration create su
# dataspace.copernicus.eu → Dashboard → Sentinel Hub → Configuration Utility.
# Non è un secret in senso stretto (le richieste WMS a una Configuration
# pubblica non servono token), ma consuma la quota (processing units)
# dell'account: non committarlo, solo qui e nelle Environment Variables
# del provider di hosting. Se assenti, l'app ricade su NASA GIBS.
VITE_SENTINEL_INSTANCE_ID_S2=inserisci_qui_instance_id_sentinel-2-l2a
VITE_SENTINEL_INSTANCE_ID_S3=inserisci_qui_instance_id_sentinel-3-slstr

# Configuration custom (layer "LST", data source Sentinel-3 SLSTR L2 — prodotto
# SL_2_LST, temperatura di superficie fisica, non brightness temperature grezza).
VITE_SENTINEL_INSTANCE_ID_S3_LST=inserisci_qui_instance_id_sentinel-3-slstr-l2

# Configuration da template Landsat 8-9, layer "9_THERMAL" (banda B10, ~30-100m).
VITE_SENTINEL_INSTANCE_ID_LANDSAT=inserisci_qui_instance_id_landsat
